# Pathly Backend Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite)
# SQLite database will be automatically created at: data/pathly.db
DATABASE_PATH=data/pathly.db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Encryption Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_
ENCRYPTION_IV=your_16_character_iv_

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Email Configuration (Optional - for future notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# Logging
LOG_LEVEL=debug
